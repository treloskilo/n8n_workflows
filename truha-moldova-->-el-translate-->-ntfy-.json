      "id": "4875727e-c387-4a45-aefe-956c5c798a5b",
      "name": "Fetch Channel HTML",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        -1104,
        -720
      ]
    },
    {
      "parameters": {
        "jsCode": "const html = $input.first().json.data || '';\n\nconst staticData = $getWorkflowStaticData('node');\nconst lastId = staticData.lastMessageId || 0;\nconst isFirstRun = lastId === 0;\n\n// Match each message block: capture data-post id, inner text block, and message link\nconst regex = /<div class=\"tgme_widget_message[^\"]*\"\\s+data-post=\"([^\"]+)\"[\\s\\S]*?<div class=\"tgme_widget_message_text[^\"]*\"[^>]*>([\\s\\S]*?)<\\/div>/g;\n\nlet match;\nconst posts = [];\n\nwhile ((match = regex.exec(html)) !== null) {\n  const dataPost = match[1]; // e.g. \"truexa_moldova_news/12345\"\n  const idPart = dataPost.split('/')[1];\n  const id = parseInt(idPart, 10);\n  if (!id) continue;\n\n  let text = match[2] || '';\n  text = text.replace(/<br\\s*\\/?>/g, '\\n');\n  text = text.replace(/<[^>]+>/g, '');\n  text = text\n    .replace(/&amp;/g, '&')\n    .replace(/&lt;/g, '<')\n    .replace(/&gt;/g, '>')\n    .replace(/&quot;/g, '\"')\n    .replace(/&#39;/g, \"'\")\n    .trim();\n\n  if (id > lastId && text.length > 0) {\n    posts.push({\n      id,\n      text,\n      link: `https://t.me/${dataPost}`\n    });\n  }\n}\n\nposts.sort((a, b) => a.id - b.id);\n\nif (posts.length > 0) {\n  staticData.lastMessageId = posts[posts.length - 1].id;\n}\n\n// BOOTSTRAP: tin proti fora pou trexei to workflow (lastId itan 0), mono\n// apothikevoume to teleftaio id pou vrethike KAI DEN stelnoume tipota,\n// wste na min \"plimmyrisoun\" ola ta yparxonta posts tis selidas san nea.\n// Apo tin epomeni ektelesi kai meta tha pernane mono ta pragmatika nea.\nif (isFirstRun) {\n  return [];\n }\n\nreturn posts.map(p => ({ json: p }));"
      },
